{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@domain/*": ["packages/domain/*/src"],
      "@application/*": ["packages/application/*/src"],
      "@infrastructure/*": ["packages/infrastructure/*/src"]
    }
  },
  "references": [
    { "path": "packages/domain/shared-kernel" },
    { "path": "packages/domain/catalog" }
    // { "path": "packages/domain/orders" }
  ]
}
